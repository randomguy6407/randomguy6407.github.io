---
import { ArrowLeft } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import think from '../../think_emoji.svg?url';
---
<SiteLayout title="Page not found">
	<div class="shell"><section class="empty-page"><img class="empty-mark" src={think} alt="" width="72" height="72" /><h1>404 — Page not found</h1><p>The page may have moved, or the link may be incorrect.</p><a class="text-link" href="/"><ArrowLeft size={15} /> Back to the blog</a></section></div>
</SiteLayout>
