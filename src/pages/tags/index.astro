---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getTagCounts, tagUrl } from '../../lib/posts';
const tags = await getTagCounts();
---
<SiteLayout title="Topics" active="posts" description="Browse the blog by topic.">
	<div class="shell">
		<header class="page-intro"><h1>Topics</h1><p>Browse posts by topic.</p></header>
		<div class="tag-directory">{tags.map(({tag, count}) => <a href={tagUrl(tag)}>{tag}<span>{count} {count === 1 ? 'post' : 'posts'} ↗</span></a>)}</div>
		<p style="margin-top:32px"><a class="text-link" href="/posts/1/">← Back to all posts</a></p>
	</div>
</SiteLayout>
