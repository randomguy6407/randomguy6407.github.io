---
const { toc } = Astro.locals.starlightRoute;

// ToC only makes sense on individual posts. The index, /about, and the
// /tags/* filter pages should render single-column with no right rail.
const isPost =
	Astro.url.pathname.startsWith('/posts/') &&
	Astro.url.pathname !== '/posts/' &&
	!/^\/posts\/\d+\/?$/.test(Astro.url.pathname);
const hasTocEntries = (toc?.items?.length ?? 0) > 1;
const showToc = isPost && hasTocEntries;
---

{
	isPost ? (
		<main class="container-main with-toc" data-slot="docs">
			<div class="main">
				<slot />
			</div>
			{showToc && (
				<div class="toc">
					<slot name="right-sidebar" />
				</div>
			)}
		</main>
	) : (
		<main class="container-main single" data-slot="docs">
			<div class="main">
				<slot />
			</div>
		</main>
	)
}
<script>
	/* In-page anchor scrolling (ToC links, footnotes).

	   We own the whole animation in JS. Global CSS `scroll-behavior: smooth`
	   is intentionally NOT set (see blog.css): if it were, every per-frame
	   `scrollTo` below would itself be re-smoothed by the browser, so the
	   real position would lag the target and "catch up" in a lurch — the
	   teleport effect. With CSS scroll-behavior left at `auto`, each frame
	   write is instant and the rAF loop is the only thing animating.

	   `behavior: 'instant'` on every write makes that guarantee explicit so
	   the loop can't be re-smoothed even if a global rule reappears. */

	const reduced = matchMedia('(prefers-reduced-motion: reduce)');

	// Distance from a target's top to where it should rest: just below the
	// sticky header, with a little breathing room. (CSS scroll-padding only
	// applies to native fragment scrolls, not raw scrollTo, so we compute it.)
	function restY(target: Element) {
		const headerH = document.querySelector('header')?.getBoundingClientRect().height ?? 0;
		const top = target.getBoundingClientRect().top + window.scrollY;
		return Math.max(0, top - headerH - 16);
	}

	// easeInOutCubic — slow start, quick middle, gentle settle. Reads as real
	// scrolling rather than a front-loaded snap.
	function ease(p: number) {
		return p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
	}

	let active = 0; // generation id so a new click cancels the previous animation

	function flashFootnote(id: string) {
		const target = document.getElementById(id);
		if (!target || !target.id.startsWith('user-content-fn')) return;
		target.classList.remove('footnote-flash');
		// Force a style flush so a repeat visit to the same footnote replays it.
		void target.offsetWidth;
		target.classList.add('footnote-flash');
	}

	function announceFragmentChange(id: string) {
		window.dispatchEvent(new CustomEvent('article:fragment-change', { detail: { id } }));
	}

	function smoothTo(endY: number, hash?: string) {
		const startY = window.scrollY;
		const delta = endY - startY;
		const finish = () => {
			if (!hash) return;
			history.replaceState(null, '', `#${hash}`);
			flashFootnote(hash);
			announceFragmentChange(hash);
		};

		if (reduced.matches || Math.abs(delta) < 4) {
			window.scrollTo({ top: endY, behavior: 'instant' });
			finish();
			return;
		}

		// Duration scales with distance but stays in a comfortable band, so a
		// full-page jump is visibly animated (~0.6s) without dragging.
		const duration = Math.min(Math.max(Math.abs(delta) * 0.5, 320), 650);
		const gen = ++active;
		let t0: number | null = null;

		function step(ts: number) {
			if (gen !== active) return; // superseded by a newer click
			t0 ??= ts;
			const p = Math.min((ts - t0) / duration, 1);
			window.scrollTo({ top: startY + delta * ease(p), behavior: 'instant' });
			if (p < 1) requestAnimationFrame(step);
			else finish();
		}
		requestAnimationFrame(step);
	}

	// Capture phase (the `true`) is load-bearing: Astro's ClientRouter has a
	// bubble-phase click listener that, for a same-page hash link, calls
	// navigate() → sets location.href → the browser scrolls to the anchor
	// INSTANTLY (that was the residual teleport). ClientRouter bails out when
	// it sees `ev.defaultPrevented`, so we must run first and preventDefault
	// before it. Capture listeners fire ahead of bubble listeners regardless
	// of registration order, so this wins even though ClientRouter is set up
	// earlier (in <head>).
	document.addEventListener(
		'click',
		(e) => {
			const link = (e.target as Element).closest('a[href^="#"]');
			if (!link) return;
			const raw = link.getAttribute('href')!.slice(1);
			if (!raw) return;
			const id = decodeURIComponent(raw);
			const target = document.getElementById(id);
			if (!target) return;
			e.preventDefault();
			smoothTo(restY(target), id);
		},
		true,
	);

	// Arriving with a hash in the URL: land below the header without animating
	// (a first-paint scroll animation looks worse than just being in place).
	function landOnHash() {
		if (!location.hash) return;
		const id = decodeURIComponent(location.hash.slice(1));
		const target = document.getElementById(id);
		if (target) {
			requestAnimationFrame(() => {
				window.scrollTo({ top: restY(target), behavior: 'instant' });
				flashFootnote(id);
				announceFragmentChange(id);
			});
		}
	}
	landOnHash();
	document.addEventListener('astro:page-load', landOnHash);
</script>

<style>
	.container-main {
		padding-top: calc(var(--spacing) * 2);
		padding-bottom: calc(var(--spacing) * 6);
		position: relative;
		margin-inline: auto;
		width: 100%;
	}

	.container-main.with-toc {
		max-width: 68rem;
	}

	.container-main.single {
		max-width: 48rem;
	}

	@media (min-width: 1024px) {
		.container-main {
			padding-top: calc(var(--spacing) * 8);
			padding-bottom: calc(var(--spacing) * 8);
		}
	}

	@media (min-width: 1280px) {
		.container-main.with-toc {
			display: grid;
			grid-template-columns: minmax(0, 48rem) minmax(0, 14rem);
			gap: 3rem;
			justify-content: center;
		}
	}

	.main {
		max-width: 48rem;
		min-width: 0;
		width: 100%;
		margin-inline: auto;
		padding-inline: calc(var(--spacing) * 4);
		padding-top: calc(var(--spacing) * 4);
	}

	.main :global(main) {
		display: flex;
		flex-direction: column;
		gap: calc(var(--spacing) * 6);
	}

	@media (min-width: 768px) {
		.main {
			padding-inline: 0;
		}
	}

	.toc {
		font-size: 0.875rem;
		line-height: 1.25rem;
		display: none;
	}

	@media (min-width: 1280px) {
		.toc {
			display: block;
		}
	}
</style>
