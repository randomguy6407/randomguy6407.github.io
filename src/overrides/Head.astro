---
import ClientRouter from 'astro/components/ClientRouter.astro';
const { head } = Astro.locals.starlightRoute;
---

<link rel="stylesheet" href="/critical.css" />
{/* The black-gradient look is this blog's identity, so default to dark.
    Seed the preference before Starlight's ThemeProvider inline script reads
    it (that script runs from head.map below), so first paint is already dark
    and there's no flash. The theme toggle still works — once the visitor
    picks light/dark, their choice is what's stored. */}
<script is:inline>
	try {
		if (!localStorage.getItem('starlight-theme')) {
			localStorage.setItem('starlight-theme', 'dark');
		}
	} catch (e) {}
</script>
{head.map(({ tag: Tag, attrs, content }) => {
	// collapse "Site | Site" → "Site" on pages where title = site name (e.g. home)
	if (Tag === 'title' && typeof content === 'string') {
		const parts = content.split(' | ');
		if (parts.length === 2 && parts[0].trim() === parts[1].trim()) {
			return <title>{parts[0].trim()}</title>;
		}
	}
	return <Tag {...attrs} set:html={content} />;
})}
<ClientRouter />
