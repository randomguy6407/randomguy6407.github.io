---
import ArticleTocList from '../components/ArticleTocList.astro';

const { toc, entry } = Astro.locals.starlightRoute;
const title = entry.data.title;
const items = toc?.items.filter((item) => item.slug !== '_top') ?? [];
---

{
	toc && (
		<article-toc data-min-h={toc.minHeadingLevel} data-max-h={toc.maxHeadingLevel}>
			<nav aria-labelledby="article-overview">
				<p id="article-overview" class="overview-label">Overview</p>
				<a href="#_top" class="toc-title" aria-current="true">
					{title}
				</a>
				<ArticleTocList items={items} />
			</nav>
		</article-toc>
	)
}

<script>
	class ArticleToc extends HTMLElement {
		private links: HTMLAnchorElement[] = [];
		private current?: HTMLAnchorElement;
		private controller?: AbortController;
		private frame = 0;

		connectedCallback() {
			this.controller = new AbortController();
			this.links = [...this.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
			this.current = this.querySelector<HTMLAnchorElement>('a[aria-current="true"]');

			const signal = this.controller.signal;
			window.addEventListener('scroll', this.schedule, { passive: true, signal });
			window.addEventListener('resize', this.schedule, { signal });
			window.addEventListener('hashchange', this.syncFragment, { signal });
			window.addEventListener('article:fragment-change', this.syncFragment, { signal });
			document.addEventListener('astro:page-load', this.syncFragment, { signal });

			// Two frames lets the page's custom hash-landing script settle first.
			requestAnimationFrame(() => requestAnimationFrame(this.syncFragment));
		}

		disconnectedCallback() {
			this.controller?.abort();
			cancelAnimationFrame(this.frame);
		}

		private schedule = () => {
			if (this.frame) return;
			this.frame = requestAnimationFrame(this.updateCurrent);
		};

		private syncFragment = (event?: Event) => {
			let id = '';
			let hasExplicitFragment = false;
			if (event instanceof CustomEvent && typeof event.detail?.id === 'string') {
				id = event.detail.id;
				hasExplicitFragment = true;
			} else if (location.hash) {
				hasExplicitFragment = true;
				try {
					id = decodeURIComponent(location.hash.slice(1));
				} catch {
					id = '';
				}
			}

			const link = id
				? this.links.find((candidate) => candidate.hash === `#${encodeURIComponent(id)}`)
				: undefined;
			if (link) {
				this.setCurrent(link);
				return;
			}
			if (hasExplicitFragment) {
				const overview = this.links.find((candidate) => candidate.hash === '#_top');
				if (overview) this.setCurrent(overview);
				return;
			}
			this.schedule();
		};

		private setCurrent(link: HTMLAnchorElement) {
			if (link === this.current) return;
			this.current?.removeAttribute('aria-current');
			link.setAttribute('aria-current', 'true');
			this.current = link;
		}

		private updateCurrent = () => {
			this.frame = 0;
			const minHeading = Number.parseInt(this.dataset.minH ?? '2', 10);
			const maxHeading = Number.parseInt(this.dataset.maxH ?? '3', 10);
			const levels = Array.from(
				{ length: maxHeading - minHeading + 1 },
				(_, index) => `h${minHeading + index}[id]`,
			).join(', ');
			const headings = [
				...document.querySelectorAll<HTMLHeadingElement>(`main h1#_top, main :is(${levels})`),
			];
			if (headings.length === 0) return;

			const headerBottom = document.querySelector('header')?.getBoundingClientRect().bottom ?? 0;
			const marker = headerBottom + 32;
			let activeHeading = headings[0];
			for (const heading of headings) {
				if (heading.getBoundingClientRect().top <= marker) activeHeading = heading;
				else break;
			}

			const link = this.links.find(
				(candidate) => candidate.hash === `#${encodeURIComponent(activeHeading.id)}`,
			);
			if (link) this.setCurrent(link);
		};
	}

	if (!customElements.get('article-toc')) {
		customElements.define('article-toc', ArticleToc);
	}
</script>

<style>
	article-toc {
		display: block;
		height: 100%;
		overflow: auto;
		scrollbar-width: none;
		padding-bottom: calc(var(--spacing) * 10);
	}

	article-toc nav {
		min-width: 0;
		border-left: 1px solid var(--border);
		padding-left: 1rem;
	}

	.overview-label {
		display: inline-block;
		margin: 0 0 0.7rem;
		padding-bottom: 0.25rem;
		border-bottom: 1px solid var(--foreground);
		font-family: var(--__sl-font-mono, ui-monospace, monospace);
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		color: var(--foreground);
	}

	.toc-title {
		display: block;
		margin: 0 0 0.85rem;
		color: var(--muted-foreground);
		font-size: 0.84rem;
		font-weight: 400;
		line-height: 1.35;
		text-decoration: none;
		overflow-wrap: anywhere;
		opacity: 0.55;
		transition: opacity 0.15s ease, color 0.15s ease;
	}

	.toc-title:hover,
	.toc-title:focus-visible {
		color: var(--foreground);
		opacity: 0.7;
	}

	.toc-title[aria-current='true'] {
		color: var(--foreground);
		font-weight: 600;
		opacity: 1;
	}
</style>
