---
import { formatDate, readingMinutes } from '../lib/posts';

const { entry } = Astro.locals.starlightRoute;
const { title, description, date, tags } = entry.data as {
	title: string;
	description?: string;
	date?: Date;
	tags?: string[];
};

const readingTime =
	date && typeof entry.body === 'string' ? readingMinutes(entry.body) : null;

const dateStr = date ? formatDate(date) : null;
const dateIso = date ? date.toISOString() : null;
const tagList = tags ?? [];
---

<div data-slot="doc-title">
	<h1 id="_top">{title}</h1>
	{
		(dateStr || readingTime !== null) && (
			<p class="post-meta">
				{dateStr && <time datetime={dateIso}>{dateStr}</time>}
				{dateStr && readingTime !== null && <span class="sep"> · </span>}
				{readingTime !== null && <span>{readingTime} min read</span>}
			</p>
		)
	}
	{
		tagList.length > 0 && (
			<div class="post-tags">
				{tagList.map((t) => (
					<a class="tag-chip" href={`/tags/${t}/1/`}>
						{t}
					</a>
				))}
			</div>
		)
	}
	{description && <p slot="doc-title-description">{description}</p>}
</div>

<style>
	div[data-slot='doc-title'] {
		display: flex;
		flex-direction: column;
		gap: calc(var(--spacing) * 2);
	}

	h1 {
		letter-spacing: var(--tracking-tight);
		font-weight: 600;
		font-size: 1.875rem;
		line-height: 2.25rem;
		scroll-margin: 5rem;
		margin: 0;
		color: var(--foreground);
	}

	.post-meta {
		margin: 0;
		font-size: 0.85rem;
		line-height: 1.4;
		color: var(--muted-foreground);
		font-variant-numeric: tabular-nums;
	}

	.post-meta .sep {
		opacity: 0.6;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: calc(var(--spacing) * 1);
	}

	[slot='doc-title-description'] {
		margin: 0;
		color: var(--muted-foreground);
		font-size: 1rem;
		line-height: 1.75rem;
		text-wrap: balance;
	}

	@media (min-width: 640px) {
		[slot='doc-title-description'] {
			max-width: 80%;
		}
	}
</style>
