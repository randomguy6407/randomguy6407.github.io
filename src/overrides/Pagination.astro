---
import { getPosts, isBlogPost, type Post } from '../lib/posts';

const { entry } = Astro.locals.starlightRoute;
const currentId: string = entry.id;

let older: Post | null = null;
let newer: Post | null = null;

if (isBlogPost(entry)) {
	const posts = await getPosts();
	const i = posts.findIndex((p) => p.id === currentId);
	if (i !== -1) {
		older = posts[i + 1] ?? null;
		newer = posts[i - 1] ?? null;
	}
}
---

{
	(older || newer) && (
		<nav class="blog-pagination" aria-label="post navigation">
			{older ? (
				<a href={`/${older.id}/`} class="cell older">
					<span class="label">← older</span>
					<span class="title">{older.data.title}</span>
				</a>
			) : (
				<span class="cell empty" />
			)}
			{newer ? (
				<a href={`/${newer.id}/`} class="cell newer">
					<span class="label">newer →</span>
					<span class="title">{newer.data.title}</span>
				</a>
			) : (
				<span class="cell empty" />
			)}
		</nav>
	)
}

<style>
	.blog-pagination {
		margin-top: calc(var(--spacing) * 10);
		padding-top: calc(var(--spacing) * 6);
		border-top: 1px solid var(--border);
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: calc(var(--spacing) * 3);
	}
	.cell {
		display: flex;
		flex-direction: column;
		gap: calc(var(--spacing) * 1);
		text-decoration: none;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);
		color: inherit;
		transition: border-color 0.15s ease, background 0.15s ease;
	}
	.cell.empty {
		border: 1px dashed transparent;
		background: transparent;
	}
	a.cell:hover {
		border-color: var(--foreground);
		background: var(--muted, transparent);
	}
	.label {
		font-size: 0.78rem;
		color: var(--muted-foreground);
		font-variant-numeric: tabular-nums;
	}
	.title {
		font-weight: 600;
		color: var(--foreground);
		font-size: 0.95rem;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.newer {
		text-align: right;
		align-items: flex-end;
	}
	@media (max-width: 540px) {
		.blog-pagination {
			grid-template-columns: 1fr;
		}
		.cell.empty {
			display: none;
		}
		.newer {
			text-align: left;
			align-items: flex-start;
		}
	}
</style>
