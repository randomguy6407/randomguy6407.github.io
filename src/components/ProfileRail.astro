---
import { Image } from 'astro:assets';
import { ArrowUpRight, ArrowRight } from '@lucide/astro';
import { getTagCounts, tagUrl } from '../lib/posts';
import { cves, SIDEBAR_CVES } from '../data/site';
const tags = await getTagCounts();
interface Props { showBio?: boolean; showCves?: boolean }
const { showBio = true, showCves = showBio } = Astro.props;
---
<aside class="home-rail" aria-label="About the author and topics">
	{showBio && <section class="rail-section">
		<h2 class="rail-heading">About</h2>
		<p class="rail-name">Hi, I’m Zenneth.</p>
		<p>I go by randomguy6407. I mainly do web exploitation in CTFs, with some binary exploitation on the side.</p>
		<a class="text-link" href="/about/">More about me <ArrowRight size={13} /></a>
	</section>}
	{showCves && <section class="rail-section">
		<h2 class="rail-heading">My CVEs</h2>
		<ul class="rail-cves">
			{cves.slice(0, SIDEBAR_CVES).map((cve) => <li>{cve.href ? <a href={cve.href} target="_blank" rel="noopener noreferrer">{cve.id}</a> : <span class="rail-cve-id">{cve.id}</span>}<span class="rail-cve-vendor" title={cve.vendor}>{cve.icon && <Image src={cve.icon} alt="" width={32} height={32} loading="lazy" />}<span>{cve.vendor}</span></span></li>)}
		</ul>
		{cves.length > SIDEBAR_CVES && <a class="text-link rail-more" href="/about/#cves">All {cves.length} CVEs <ArrowRight size={13} /></a>}
	</section>}
	<section class="rail-section">
		<h2 class="rail-heading">Elsewhere</h2>
		<ul class="elsewhere">
			<li><a href="https://github.com/randomguy6407">GitHub <ArrowUpRight /></a></li>
			<li><a href="https://hackerone.com/randomguy6407">HackerOne <ArrowUpRight /></a></li>
			<li><a href="https://dreamhack.io/users/87167">Dreamhack <ArrowUpRight /></a></li>
			<li><a href="https://www.linkedin.com/in/zennethgaw">LinkedIn <ArrowUpRight /></a></li>
		</ul>
	</section>
	<section class="rail-section">
		<h2 class="rail-heading">Topics</h2>
		<div class="rail-topics">{tags.map(({tag}) => <a class="tag-chip" href={tagUrl(tag)}><span class="tag-hash" aria-hidden="true">#</span>{tag}</a>)}</div>
	</section>
</aside>
