---
import type { MarkdownHeading } from 'astro';

interface TocItem extends MarkdownHeading {
	children: TocItem[];
}

interface Props {
	items: TocItem[];
}

const { items } = Astro.props;
---

{
	items.length > 0 && (
		<ul class="toc-list">
			{items.map((heading) => (
				<li>
					<a href={`#${heading.slug}`}>{heading.text}</a>
					{heading.children.length > 0 && <Astro.self items={heading.children} />}
				</li>
			))}
		</ul>
	)
}

<style>
	.toc-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.toc-list li {
		min-width: 0;
	}

	.toc-list a {
		display: block;
		color: var(--muted-foreground);
		font-size: 0.8rem;
		font-weight: 400;
		line-height: 1.35;
		text-decoration: none;
		overflow-wrap: anywhere;
		opacity: 0.55;
		transition: opacity 0.15s ease, color 0.15s ease;
	}

	.toc-list a:hover,
	.toc-list a:focus-visible {
		color: var(--foreground);
		opacity: 1;
	}

	.toc-list a[aria-current='true'] {
		color: var(--foreground);
		font-weight: 500;
		opacity: 1;
	}

	.toc-list .toc-list {
		margin-top: 0.45rem;
		padding-left: 0.75rem;
	}
</style>
