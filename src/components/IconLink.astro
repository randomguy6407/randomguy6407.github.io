---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	/** Destination. Omit for a non-clickable item (e.g. a Discord handle). */
	href?: string;
	label: string;
	/** Imported favicon (astro:assets optimizes + bundles it locally). */
	icon: ImageMetadata;
}
const { href, label, icon } = Astro.props;
const Tag = href ? 'a' : 'span';
// External profile/reference links: open in a new tab, no referrer leakage.
const linkAttrs = href ? { href, target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Tag class="icon-link" {...linkAttrs}>
	<Image src={icon} alt="" width={40} height={40} class="icon-link__img" loading="lazy" />
	<span>{label}</span>
</Tag>

<style>
	.icon-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.3rem 0.6rem;
		border: 1px solid var(--border);
		border-radius: 9999px;
		font-size: 0.85rem;
		line-height: 1;
		color: var(--muted-foreground);
		text-decoration: none;
		transition: border-color 0.15s ease, color 0.15s ease;
	}
	a.icon-link:hover {
		border-color: var(--foreground);
		color: var(--foreground);
	}
	/* Non-clickable variant (a bare handle) reads as static, not interactive. */
	span.icon-link {
		cursor: default;
	}
	.icon-link__img {
		width: 1.05rem;
		height: 1.05rem;
		border-radius: 3px;
		flex-shrink: 0;
	}
</style>
